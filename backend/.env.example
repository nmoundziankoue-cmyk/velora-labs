# Clé API Gemini. Récupère une clé gratuite sur https://aistudio.google.com/apikey
GEMINI_API_KEY=

# URL de connexion Postgres (obligatoire, le serveur refuse de démarrer sans).
# En local : installe Postgres puis crée une base, ex avec Homebrew :
#   brew install postgresql@16
#   createdb velora_dev
#   DATABASE_URL=postgresql://localhost/velora_dev
# En prod (Render) : voir render.yaml — la variable est injectée
# automatiquement depuis la base Postgres managée liée au service.
DATABASE_URL=

# URL du frontend autorisée en CORS (production). En dev local, le backend
# autorise déjà http://localhost:3000 par défaut, pas besoin de définir cette
# variable. En prod, mets l'URL Vercel du frontend déployé, ex:
# https://velora-labs.vercel.app
FRONTEND_URL=
