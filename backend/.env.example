# Clé API Gemini. Récupère une clé gratuite sur https://aistudio.google.com/apikey
GEMINI_API_KEY=

# URL du frontend autorisée en CORS (production). En dev local, le backend
# autorise déjà http://localhost:3000 par défaut, pas besoin de définir cette
# variable. En prod, mets l'URL Vercel du frontend déployé, ex:
# https://velora-labs.vercel.app
FRONTEND_URL=
